# Configuración de Doxygen para el proyecto "Sistema de streaming de audio con RPC".
# Generar la documentación (desde esta carpeta):  doxygen Doxyfile
# Resultado: documentacion/html/index.html
#
# Doxygen no reconoce Go de forma nativa; por eso los archivos .go se tratan
# como C++ (EXTENSION_MAPPING) y pasan por el filtro filtro_go_doxygen.py
# (FILTER_PATTERNS), que traduce las declaraciones de Go conservando los
# comentarios de documentación.

#---------------------------------------------------------------------------
# Proyecto
#---------------------------------------------------------------------------
PROJECT_NAME           = "Spotify distribuido - RPC"
PROJECT_BRIEF          = "Streaming de audio con gRPC, REST y cola de mensajes en Go"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = documentacion
OUTPUT_LANGUAGE        = Spanish
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Archivos de entrada
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         Cliente \
                         Administrador \
                         ServidorMetadataDeAudios \
                         ServidorDeStreaming \
                         ServidorDeAudios \
                         ServidorDeEstadisticas
FILE_PATTERNS          = *.go *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = *.pb.go
EXTENSION_MAPPING      = go=C++
FILTER_PATTERNS        = "*.go=python3 filtro_go_doxygen.py"
FILTER_SOURCE_FILES    = NO
USE_MDFILE_AS_MAINPAGE = README.md
INPUT_ENCODING         = UTF-8

#---------------------------------------------------------------------------
# Extracción
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SHOW_NAMESPACES        = YES
SORT_MEMBER_DOCS       = NO
INLINE_INHERITED_MEMB  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = documentacion/advertencias_doxygen.log

#---------------------------------------------------------------------------
# Salida
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
CLASS_GRAPH            = YES
HAVE_DOT               = NO
QUIET                  = YES
